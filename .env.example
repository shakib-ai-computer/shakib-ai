# SHAKIB AI — environment template. Copy to `.env` and fill in real values.
# NEVER commit a filled-in .env. No real keys belong in this file.

# --- PostgreSQL ---
POSTGRES_USER=shakib
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- new-api gateway (service config) ---
GATEWAY_PORT=3000
NEW_API_SESSION_SECRET=

# --- SHAKIB AI Core ---
CORE_PORT=8000
# Key issued BY the gateway for Core's server-side use. Never exposed to the browser.
GATEWAY_API_KEY=
# Gateway base URL for Core (the compose file sets this to the gateway service).
GATEWAY_BASE_URL=http://localhost:3000/v1
# Model roles: comma-separated fallback chains of gateway model names,
# tried in order (e.g. MODEL_SMART=model-a,model-b). Empty = role unused.
MODEL_FAST=
MODEL_SMART=
MODEL_STRATEGIC=
MODEL_EMBEDDING=
# HMAC secret for SHAKIB AI's own JWT auth.
JWT_SECRET=
# Core database. Dev default (unset) is a local SQLite file
# (sqlite:///./data/shakib.db); docker-compose sets this to PostgreSQL.
# Leave commented out for the dev default — an empty value is invalid.
#DATABASE_URL=postgresql+psycopg://shakib:CHANGE_ME@postgres:5432/shakib_core
# Fernet key (urlsafe base64, 32 bytes) encrypting user-supplied provider
# API keys at rest. If unset, a key is derived from JWT_SECRET — dev only;
# production MUST set this so JWT rotation cannot orphan stored keys.
ENCRYPTION_KEY=
# When true, chat/research/council require a valid JWT (401 otherwise).
AUTH_REQUIRED=false
# Browser origins Core accepts CORS requests from (comma-separated).
# Dev default covers the Vite dev server. PRODUCTION MUST set this to the
# exact deployed web origin(s) — never "*", requests carry credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Tavily web-research key (Core, server-side only).
TAVILY_API_KEY=
# gpt-researcher retriever. Default "tavily" needs TAVILY_API_KEY above;
# key-free alternatives (lower quality): duckduckgo, arxiv, openalex.
RETRIEVER=tavily

# --- Web ---
WEB_PORT=5173
VITE_CORE_API_URL=http://localhost:8000

# --- Misc ---
TZ=Asia/Dhaka
